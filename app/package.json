{
  "name": "nte-mod-manager",
  "version": "2.0.0",
  "description": "NTE 模组管理器",
  "main": "./out/main/index.js",
  "author": "Nuoyan",
  "private": true,
  "scripts": {
    "dist": "node scripts/test-images.mjs off && node scripts/dist.mjs",
    "dist:bg-server": "node scripts/test-images.mjs off && node scripts/dist.mjs bg-server",
    "dev": "node scripts/test-images.mjs on && vite --config web.vite.config.ts --open",
    "dev:electron": "node scripts/test-images.mjs on && electron-vite dev",
    "build": "node scripts/test-images.mjs on && electron-vite build",
    "preview": "node scripts/test-images.mjs on && electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.4.7",
    "iconv-lite": "^0.6.3",
    "vaso": "^1.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
